AWSTemplateFormatVersion: '2010-09-09'
Description: >
  S3 versioned bucket triggers Lambda, which writes object info to Parameter Store, then starts CodeBuild to deploy CDK.

Parameters:
  CodeBuildImage:
    Type: String
    Default: "aws/codebuild/standard:6.0"
    Description: "CodeBuild image version supporting Node.js 18"

Resources:
  DeployBucket:
    Type: AWS::S3::Bucket
    Properties:
      VersioningConfiguration:
        Status: Enabled

  S3BucketParameter:
    Type: AWS::SSM::Parameter
    Properties:
      Name: /cdk/deploy/bucket
      Type: String
      Value: ""
      Description: "Latest S3 bucket name for deployment artifact"

  S3ObjectKeyParameter:
    Type: AWS::SSM::Parameter
    Properties:
      Name: /cdk/deploy/object
      Type: String
      Value: ""
      Description: "Latest uploaded ZIP object key for deployment"

  CodeBuildServiceRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Service: codebuild.amazonaws.com
            Action: sts:AssumeRole
      Path: /
      Policies:
        - PolicyName: CodeBuildPermissions
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - s3:GetObject
                  - s3:GetObjectVersion
                  - s3:ListBucket
                Resource: "*"
              - Effect: Allow
                Action:
                  - ssm:GetParameter
                Resource: "*"
              - Effect: Allow
                Action:
                  - logs:*
                  - ec2:Describe*
                  - cloudwatch:PutMetricData
                  - autoscaling:Describe*
                  - cloudformation:*
                  - sts:AssumeRole
                  - iam:*
                  - cdk:*
                  - ecr:*
                Resource: "*"

  CodeBuildProject:
    Type: AWS::CodeBuild::Project
    Properties:
      Name: CDKDeployProject
      ServiceRole: !GetAtt CodeBuildServiceRole.Arn
      Artifacts:
        Type: NO_ARTIFACTS
      Environment:
        Type: LINUX_CONTAINER
        Image: !Ref CodeBuildImage
        ComputeType: BUILD_GENERAL1_SMALL
        PrivilegedMode: false
        EnvironmentVariables: []
      Source:
        Type: NO_SOURCE
        BuildSpec: |
          version: 0.2
          phases:
            install:
              runtime-versions:
                nodejs: 18
              commands:
                - yum install -y unzip || true
            pre_build:
              commands:
                - echo "[Info] Fetching parameters from SSM..."
                - S3_BUCKET=$(aws ssm get-parameter --name /cdk/deploy/bucket --query "Parameter.Value" --output text)
                - ZIP_KEY=$(aws ssm get-parameter --name /cdk/deploy/object --query "Parameter.Value" --output text)
                - echo "[Info] Downloading $ZIP_KEY from $S3_BUCKET"
                - aws s3 cp s3://$S3_BUCKET/$ZIP_KEY ./app.zip
                - unzip app.zip -d ./app
                - cd app
                - npm install
            build:
              commands:
                - npm run build
                - npx cdk bootstrap
                - npx cdk diff || true
                - npx cdk deploy --require-approval=never
          cache:
            paths:
              - 'app/node_modules/**/*'
              - 'app/.npm/**/*'
      TimeoutInMinutes: 30

  LambdaExecutionRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Service: lambda.amazonaws.com
            Action: sts:AssumeRole
      Path: /
      Policies:
        - PolicyName: LambdaInvokeAndWriteSSM
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - codebuild:StartBuild
                Resource: !GetAtt CodeBuildProject.Arn
              - Effect: Allow
                Action:
                  - ssm:PutParameter
                Resource: "*"
              - Effect: Allow
                Action:
                  - logs:CreateLogGroup
                  - logs:CreateLogStream
                  - logs:PutLogEvents
                Resource: "*"

  TriggerCodeBuildLambda:
    Type: AWS::Lambda::Function
    Properties:
      FunctionName: TriggerCDKDeployBuild
      Runtime: nodejs18.x
      Handler: index.handler
      Role: !GetAtt LambdaExecutionRole.Arn
      Timeout: 30
      Code:
        ZipFile: |
          const AWS = require('aws-sdk');
          const ssm = new AWS.SSM();
          const codebuild = new AWS.CodeBuild();

          exports.handler = async (event) => {
            console.log('Received S3 event:', JSON.stringify(event, null, 2));
            const record = event.Records[0];
            const bucketName = record.s3.bucket.name;
            const objectKey = decodeURIComponent(record.s3.object.key.replace(/\+/g, ' '));

            // Write SSM parameters
            await ssm.putParameter({
              Name: '/cdk/deploy/bucket',
              Value: bucketName,
              Overwrite: true,
              Type: 'String'
            }).promise();

            await ssm.putParameter({
              Name: '/cdk/deploy/object',
              Value: objectKey,
              Overwrite: true,
              Type: 'String'
            }).promise();

            // Start build
            const buildParams = {
              projectName: process.env.CODEBUILD_PROJECT_NAME
            };
            const result = await codebuild.startBuild(buildParams).promise();
            console.log('Build started:', result);
          }
      Environment:
        Variables:
          CODEBUILD_PROJECT_NAME: CDKDeployProject

  LambdaInvokePermission:
    Type: AWS::Lambda::Permission
    Properties:
      FunctionName: !Ref TriggerCodeBuildLambda
      Action: lambda:InvokeFunction
      Principal: events.amazonaws.com
      SourceArn: !GetAtt S3PutObjectRule.Arn

  S3PutObjectRule:
    Type: AWS::Events::Rule
    Properties:
      Description: "Trigger Lambda to start CodeBuild on S3 ZIP upload"
      EventPattern:
        source:
          - aws.s3
        detail-type:
          - Object Created
        resources:
          - !Sub arn:aws:s3:::${DeployBucket}
        detail:
          bucket:
            name:
              - !Ref DeployBucket
          object:
            key:
              suffix:
                - ".zip"
      Targets:
        - Arn: !GetAtt TriggerCodeBuildLambda.Arn
          Id: "TriggerLambda"

Outputs:
  BucketName:
    Description: "S3 Bucket name for uploading ZIPs"
    Value: !Ref DeployBucket
  CodeBuildProjectName:
    Description: "CodeBuild project"
    Value: !Ref CodeBuildProject
  LambdaName:
    Description: "Trigger Lambda name"
    Value: !Ref TriggerCodeBuildLambda
